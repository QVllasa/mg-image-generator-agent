# ═══════════════════════════════════════════════════════════════════════════════
# Room Stager Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# fal.ai (REQUIRED)
FAL_API_KEY=your_fal_api_key_here

# vLLM (Qwen3-VL)
VLLM_ENDPOINT=http://localhost:8081/v1
VLLM_MODEL=qwen3-vl-thinking
VLLM_REQUEST_TIMEOUT=300

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Limits
MAX_IMAGES_PER_REQUEST=5
MAX_RETRIES=2

# MeiliSearch
MEILISEARCH_PRODUCTS_URL=http://localhost:7700
MEILISEARCH_PRODUCTS_KEY=
MEILISEARCH_METADATA_URL=http://localhost:7701
MEILISEARCH_METADATA_KEY=
PRODUCTS_PER_TYPE=5

# ═══════════════════════════════════════════════════════════════════════════════
# NEW: Production Infrastructure
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL (Job Tracking)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=staging
POSTGRES_PASSWORD=staging_secret
POSTGRES_DB=staging_jobs

# MinIO (Image Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=staging-images
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
